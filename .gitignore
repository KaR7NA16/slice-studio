# 留档（删除前的旧实现，可随时整个删）
_attic/

# 依赖与构建产物
node_modules/
dist/

# 运行时工作文件（素材索引、任务产物）
data/
work/

# 外部工具二进制（自带固定版，不入库）
tools/ffmpeg/
tools/node/
tools/python/

# 随包预置的模型权重（80.2MB，分发时打进绿色目录，不入库）
# 内容：models/demucs/{htdemucs.yaml, 955717e8-8726e21a.th}
# 加载方式：Separator(model="htdemucs", repo=<数据根>/models/demucs) → LocalRepo，零网络
models/

# 项目素材库（97 首 mp3 / 484MB，不入库）
# 索引在 data/library.json，source_root 记相对路径 assets，指向可在界面改。
assets/

# 本机密钥配置（模板 config.example.json 入库）
config.json

# 项目记忆链（agent 生成，每会话重写；含本机绝对路径，不随仓库分发）
.workbuddy-ai/

# 其他
*.log
.DS_Store

# 启动器编译产物（源码在 launcher/Launcher.cs，双击前由 csc 编到目录根）
/slice-studio.exe

# Python 运行缓存
__pycache__/
*.pyc

# agent 会话记忆（每会话重写，含本机绝对路径，不随仓库分发）
.workbuddy/

# 文档留在本机，不进远端
docs/
